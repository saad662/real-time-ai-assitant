# Copy this file to .env and fill in your key.
#   copy .env.example .env
# .env is gitignored. Never commit it, never paste it into a chat.

# ============================================================================
# LLM  (required)
# ============================================================================
OPENAI_API_KEY=sk-your-key-here
LLM_PROVIDER=openai
# gpt-4o-mini is the latency/cost sweet spot. gpt-4o is smarter and ~2x slower
# to first token.
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=700
LLM_TIMEOUT=30

# ---------------------------------------------------------------------------
# FASTEST OPTION: point at an OpenAI-compatible provider built for speed.
# Groq and Cerebras run on custom inference hardware and typically start
# replying in 100-250 ms instead of 400-700 ms. Same wire protocol, so nothing
# else changes. Put THEIR key in OPENAI_API_KEY above.
#
# Groq       https://console.groq.com/keys
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.1-8b-instant          (fastest; fine for common questions)
#   LLM_MODEL=llama-3.3-70b-versatile       (smarter, still very fast)
#
# Cerebras   https://cloud.cerebras.ai
#   LLM_BASE_URL=https://api.cerebras.ai/v1
#   LLM_MODEL=llama3.1-8b
#
# OpenAI's own fastest is LLM_MODEL=gpt-4.1-nano with no base URL.
# Model names change - check the provider's model list if one is rejected.
LLM_BASE_URL=

# To use Claude instead:
#   LLM_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=sk-ant-...
#   LLM_MODEL=claude-haiku-4-5-20251001
#   (and: pip install anthropic)
ANTHROPIC_API_KEY=

# ============================================================================
# Speech to text
# ============================================================================
# local    = faster-whisper on your CPU. No extra key, works offline, but the
#            decode lands directly on the critical path (see the table below).
# deepgram = streaming API. Roughly 1 second faster end to end. Needs a key.
STT_PROVIDER=local

# Local model size. Warm decode of a 2.8 s utterance, measured on a Ryzen 7
# PRO 4750U laptop CPU:
#   tiny.en  ~75 MB    ~390 ms   default; occasionally fumbles jargon
#   base.en  ~145 MB   ~745 ms   clearly better wording
#   small.en ~480 MB   ~4.4 s    too slow for live use on a laptop CPU
# Decode time barely grows with utterance length (Whisper pads to a 30 s
# window either way): 2.8 s costs 390 ms, 5.3 s costs 409 ms.
STT_MODEL=tiny.en
# int8 is the fastest CPU option. Use int8_float32 if you see accuracy issues.
STT_COMPUTE=int8
STT_LANGUAGE=en

# How often, in seconds, to re-decode the current utterance for a partial.
# Lower = partials appear sooner but cost more CPU.
PARTIAL_INTERVAL=0.7

# THE BIGGEST LATENCY SETTING. When the speaker goes quiet, start decoding
# after this many seconds instead of waiting out END_OF_UTTERANCE_SILENCE
# first. Everything after this point is silence, so the transcript is the same
# - it is just ready by the time the utterance officially ends, which takes the
# whole speech-to-text cost off the critical path. Measured: 1319 ms -> 609 ms.
# Must be less than END_OF_UTTERANCE_SILENCE.
PAUSE_DECODE_AFTER=0.20

# Burn one throwaway decode at startup. The first decode after loading is about
# twice as slow as a warm one (850 ms vs 390 ms), and this moves that cost off
# your first question. Costs ~0.4 s of extra startup time.
WARMUP_MODEL=true

# Deepgram (only used when STT_PROVIDER=deepgram)
# This is the biggest remaining latency win: it removes local transcription
# entirely, so nothing has to be decoded on your CPU at all.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Deepgram's server-side end-of-speech detection, in milliseconds. Its
# equivalent of END_OF_UTTERANCE_SILENCE, but running on a real streaming
# model, so it can be much tighter than the local 700 ms.
DEEPGRAM_ENDPOINTING=300
# Endpoint override, for a self-hosted Deepgram or for testing.
DEEPGRAM_URL=wss://api.deepgram.com/v1/listen

# ============================================================================
# Audio input
# ============================================================================
# loopback   = what your computer is PLAYING (the other person in the call)
# microphone = what your microphone hears (you)
AUDIO_MODE=loopback

# Empty = Windows default playback device.
# Otherwise a device index or part of a device name.
# Run `python app.py --list-devices` to see the options.
AUDIO_DEVICE=

# ============================================================================
# Voice activity detection
# ============================================================================
# Absolute floor in dBFS. Anything quieter is never speech.
# Lower it (e.g. -55) if quiet speakers are being missed.
VAD_THRESHOLD_DB=-45
# How far above the measured noise floor counts as speech.
VAD_MARGIN_DB=7
# Ignore bursts shorter than this (seconds) - rejects clicks and keystrokes.
MIN_SPEECH_DURATION=0.20
# Silence needed before we decide the question is finished. This is the single
# biggest latency knob. Below ~0.5 you will start cutting people off.
END_OF_UTTERANCE_SILENCE=0.70
# Hard cap - a long monologue still gets processed.
MAX_UTTERANCE_SECONDS=30
# Audio kept before speech is detected, so the first word is never clipped.
PREROLL_SECONDS=0.35

# ============================================================================
# Question handling
# ============================================================================
# How many past exchanges are sent as context. More = better follow-up
# understanding, more tokens, slower first response.
CONTEXT_TURNS=5
# Fire the LLM as soon as the pause transcript reads as a complete question,
# instead of waiting out the rest of END_OF_UTTERANCE_SILENCE. Worth about
# another 80 ms on top of PAUSE_DECODE_AFTER. Before firing it re-checks that
# the speaker has not resumed, so it does not answer half a question.
SPECULATIVE_START=true
SPECULATIVE_MIN_WORDS=5

# Answer WHILE THE PERSON IS STILL TALKING. This is the only setting that can
# put an answer on screen before they finish asking.
#
# It is a gamble, not a free optimisation. As soon as a mid-speech transcript
# reads as a complete question ("What is overfitting in machine learning"), the
# request goes out. If they then add "...and how do you prevent it on edge
# hardware?", the first answer is thrown away and a new one is requested. You
# will see the answer get cleared and rewritten, and you pay for both.
#
# Worth turning on when questions are short and self-contained. Turn it off if
# the person tends to think out loud or tack on clauses.
EAGER_ANSWER=false
# Minimum words before an unfinished question is worth answering.
EAGER_MIN_WORDS=6
# Confidence bar. Do not raise this much above 0.65 - a mid-speech transcript
# has no question mark yet, and without one even a textbook "What is X in Y"
# only scores 0.67, so a higher bar means this effectively never fires.
EAGER_CONFIDENCE=0.65
# Similarity above which a new question counts as one we already answered.
DUPLICATE_SIMILARITY=0.90
DUPLICATE_WINDOW=45

# ============================================================================
# UI
# ============================================================================
ANSWER_MODE=NORMAL
FONT_SIZE=13
ALWAYS_ON_TOP=true
HOTKEYS_ENABLED=true

# ============================================================================
# Privacy and logging
# ============================================================================
# Audio is processed in memory and never written to disk unless you turn this
# on. Leave it false.
SAVE_AUDIO=false
LOG_LEVEL=INFO
